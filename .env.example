# ── Database (set ONE of these in Heroku config vars) ──────────────────────
# Option 1: MongoDB Atlas
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/cybersecpro

# Option 2: PostgreSQL (Heroku Postgres add-on sets this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Required ────────────────────────────────────────────────────────────────
JWT_SECRET=your-very-long-random-secret-at-least-32-chars

# ── Optional ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# Auto-create admin on first boot
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=StrongPassword123!

# WhatsApp worker tuning for Heroku Standard-1X / 1 GB worker dyno (60 bots via LRU rotation)
WHATSAPP_HOST_DYNO=worker
BOT_ISOLATION=1
DYNO_TOTAL_RAM_MB=1024
BOT_CHILD_HEAP_MB=96
MAX_MEM_PERCENT=78
MAX_CONCURRENT_BOTS=7
BOT_DISABLE_CHAT_STORE=1
# Turbo ON for 60-bot LRU rotation — only swaps when linked bots > MAX_CONCURRENT (safe for 1–7 bots too)
BOT_TURBO_ROTATION=1
BOT_SYNC_INTERVAL_MS=2000
BOT_ROTATION_INTERVAL_SEC=30
BOT_ROTATION_SWAP_MS=800
BOT_ROTATIONS_PER_SYNC=2
BOT_MIN_UPTIME_MS=300000
# Per-bot + full dyno memory restart (hours). 3 = recommended; 0 = disable
# Supervisor/worker: restarts entire worker dyno (all bots). Web dyno also restarts.
BOT_RESTART_HOURS=3
SYNC_FULL_HISTORY=0
# ── WhatsApp socket reliability (commands stop after 2-3 min fix) ────────────
# WS keep-alive ping interval (ms). MUST be ~30000. Lower values (3s/10s) look
# like spam to WhatsApp → rate-overlimit → server silently stops delivering
# messages while the socket stays "online". Never go below 15000.
WA_KEEPALIVE_MS=30000
# Register the device as an ACTIVE receiver so WhatsApp keeps pushing messages.
# Set to 0 only if you do not want the bot to appear online to contacts (this
# can reduce real-time delivery reliability). Neither flag triggers the phone
# "Syncing. Keep app open." hang — that is SYNC_FULL_HISTORY only.
WA_MARK_ONLINE=1
WA_FIRE_INIT_QUERIES=1
TOTAL_WORKER_DYNOS=1
BOTS_PER_DYNO=60
# Optional: scale workers when bot count grows (requires HEROKU_API_TOKEN + HEROKU_APP_NAME)
# HEROKU_API_TOKEN=
# HEROKU_APP_NAME=

# CORS — leave empty in production (same-origin requests don't need it)
# ALLOWED_ORIGINS=https://yourapp.herokuapp.com

# Optional: override the SMS bomber API endpoint
# SMS_BOMBER_API_URL=https://amscript.xyz/PublicApi/sms.php
